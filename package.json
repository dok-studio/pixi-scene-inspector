{
  "name": "pixi-scene-inspector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scene Inspector for PixiJS — DevTools extension for inspecting the scene graph and textures of PixiJS applications.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc -p apps/playground --noEmit && tsc -p apps/chrome --noEmit",
    "playground": "npm run dev --workspace @scene-inspector/app-playground",
    "build:chrome": "npm run build --workspace @scene-inspector/app-chrome",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^24.13.4",
    "eslint": "^9.13.0",
    "happy-dom": "^20.11.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.10"
  }
}
